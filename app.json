{
  "expo": {
    "name": "Meant To",
    "slug": "meant-to",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.meantto.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Meant To reads your Screenshots album to find the things you meant to do.",
        "NSContactsUsageDescription": "Meant To saves contacts it finds in your screenshots.",
        "NSCalendarsUsageDescription": "Meant To adds events it finds in your screenshots to your calendar.",
        "NSCalendarsFullAccessUsageDescription": "Meant To adds events it finds in your screenshots to your calendar."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.meantto.app",
      "permissions": [
        "android.permission.CAMERA",
        "READ_MEDIA_IMAGES",
        "READ_EXTERNAL_STORAGE",
        "READ_CONTACTS",
        "WRITE_CONTACTS",
        "READ_CALENDAR",
        "WRITE_CALENDAR",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "meantto",
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "Meant To reads your Screenshots album.",
          "savePhotosPermission": "Meant To needs access to your photos.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Meant To saves contacts found in your screenshots."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Meant To adds events found in your screenshots."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Fitted uses your camera so you can take a full-body photo to style.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "36e3a304-2f82-49c9-9e00-73e0acdf4856"
      }
    },
    "owner": "rakshit1256",
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#0A0A0F"
    },
    "backgroundColor": "#0A0A0F"
  }
}